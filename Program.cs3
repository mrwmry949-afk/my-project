namespace ConsoleApp3
{
    internal class Program
    {
        static void Main(string[] args)
        {
 
            string[] data = Console.ReadLine().Split();
             
            long x = long.Parse(data[0]);
            long y = long.Parse(data[1]);
            Console.WriteLine($"{x} + {y} = {x + y}");
            Console.WriteLine($"{x} * {y} = {x * y}");
            Console.WriteLine($"{x} - {y} = {x - y}");
 
        }
    }
}
