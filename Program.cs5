namespace C__Fundamental.ConsoleApp
{
    internal class Program
    {
        static void Main(string[] args)
 
        {
            string[] data = Console.ReadLine().Split();
            long x, y, z, e;
            x = int.Parse(data[0]);
            y = int.Parse(data[1]);
            z = int.Parse(data[2]);
            e = int.Parse(data[3]);
            Console.WriteLine($"Difference = {(x * y) - (z * e)}");
        }
    }
}
 
